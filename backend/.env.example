# Namuna fayl. Haqiqiy qiymatlarni .env ga yozing (yoki hosting'ning
# "Environment Variables" bo'limiga qo'ying). .env GitHub'ga YUKLANMAYDI.

# PostgreSQL (Neon) ulanishi
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Telegram Bot Token (BotFather)
BOT_TOKEN="123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Server porti (hosting o'zi beradi, odatda o'zgartirmaysiz)
PORT=5000

# Muhit
NODE_ENV=production

# Mini App HTTPS manzili (deploy qilingandan keyin qo'yiladi)
MINI_APP_URL=""

# Admin Panel paroli (kirish uchun)
ADMIN_PASSWORD="maxfiy-parol-shu-yerga"

# Kuryerlar Telegram guruhi ID'si (botni guruhga qo'shsangiz beriladi)
COURIER_GROUP_ID=""

# ---- Clopos (POS kassa) — Open API v2 ----
# Qiymatlarni Clopos kabinetidan oling (Add-ons → Open API) va FAQAT Render
# "Environment" bo'limiga kiriting. Bo'sh bo'lsa — integratsiya o'chiq.
CLOPOS_API_URL="https://integrations.clopos.com/open-api/v2"
CLOPOS_CLIENT_ID=""
CLOPOS_CLIENT_SECRET=""
CLOPOS_BRAND=""
CLOPOS_INTEGRATOR_ID=""
CLOPOS_VENUE_ID=""
# Ixtiyoriy: berilmasa DELIVERY / TAKEAWAY turi avtomatik tanlanadi
CLOPOS_SALE_TYPE_DELIVERY=""
CLOPOS_SALE_TYPE_PICKUP=""
# Ixtiyoriy: Coca-Cola taklifi uchun Clopos mahsulot ID'si (bo'lmasa — kola bor buyurtma xato bo'ladi)
CLOPOS_COLA_PRODUCT_ID=""
# Ixtiyoriy: yetkazish alohida mahsulot sifatida (bo'lmasa — delivery_fee maydonida)
CLOPOS_DELIVERY_PRODUCT_ID=""
# Ixtiyoriy: true — buyurtma kassada darhol qabul qilinadi (standart: kassir qo'lda qabul qiladi)
CLOPOS_AUTO_ACCEPT=""
