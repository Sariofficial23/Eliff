generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mijoz
model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  orders     Order[]
}

// Pizza / mahsulot
model Product {
  id          Int      @id @default(autoincrement())
  image       String
  name        String
  description String
  oldPrice    Int?
  newPrice    Int
  category    String
  createdAt   DateTime @default(now())
}

// Sozlamalar (key-value): bepul yetkazish chegarasi, yetkazish narxi
model Setting {
  key   String @id
  value String
}

// Aksiya banneri (bosh sahifada karusel)
model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  image     String? // ixtiyoriy rasm URL (bo'lsa — fon rasmi)
  emoji     String? // ixtiyoriy emoji (rasm bo'lmasa)
  color     String? // gradient preset: p1 | p2 | p3
  linkType  String? // 'category' | 'url' | null
  linkValue String? // kategoriya nomi yoki URL
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

// Buyurtma
model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  items     Json // [{ id, name, price, qty }]
  total     Int
  location  String?
  phone     String?
  status    String   @default("kutilmoqda") // kutilmoqda | yetkazildi
  courier   String? // buyurtmani olgan kuryer (ism/username)
  createdAt DateTime @default(now())
}
